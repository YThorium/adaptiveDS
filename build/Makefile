	$(MAKE) $(MAKESILENT) -f CMakeFiles/adaptive_ds_tests.dir/build.make CMakeFiles/adaptive_ds_tests.dir/tests/test_workload_monitor.cpp.o
.PHONY : tests/test_workload_monitor.cpp.o

tests/test_workload_monitor.i: tests/test_workload_monitor.cpp.i
.PHONY : tests/test_workload_monitor.i

# target to preprocess a source file
tests/test_workload_monitor.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/adaptive_ds_tests.dir/build.make CMakeFiles/adaptive_ds_tests.dir/tests/test_workload_monitor.cpp.i
.PHONY : tests/test_workload_monitor.cpp.i

tests/test_workload_monitor.s: tests/test_workload_monitor.cpp.s
.PHONY : tests/test_workload_monitor.s

# target to generate assembly for a file
tests/test_workload_monitor.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/adaptive_ds_tests.dir/build.make CMakeFiles/adaptive_ds_tests.dir/tests/test_workload_monitor.cpp.s
.PHONY : tests/test_workload_monitor.cpp.s

